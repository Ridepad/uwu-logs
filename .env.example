# Public local port. Open http://localhost:8080 after docker compose up.
UWU_HTTP_PORT=8080

# Main Flask process. Keep 1 worker unless you understand the in-memory report
# cache implications. Increase threads first if you need more concurrency.
UWU_MAIN_WORKERS=1
UWU_MAIN_THREADS=4
UWU_MAIN_TIMEOUT=600

# Top API can be increased independently if needed.
UWU_TOP_WORKERS=1
